# Source the PDK xschemrc file
source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc

# /foss/designs is now mounted to the repo root, so xschem assets live under
# $env(DESIGNS)/designs/... instead of $env(DESIGNS)/... directly.
# $env(DESIGNS) itself is also required: .sch files reference symbols with
# repo-root-relative paths (e.g. {dac/schematic/unit_switch.sym}), so without
# the repo root in the path those refs only resolve when xschem happens to be
# launched from /foss/designs (PDK xschemrc appends $env(PWD) by default).
set XSCHEM_LIBRARY_PATH ${XSCHEM_LIBRARY_PATH}:$env(DESIGNS):$env(DESIGNS)/designs:$env(DESIGNS)/designs/Tutorials:$env(DESIGNS)/designs/libs

set netlist_dir "/foss/designs/designs/simulations"

# Default save dialog to .sch (schematic) not .sym (symbol)
set file_dialog_defaultextension .sch

# Ensure xschem starts in schematic mode, not symbol mode
set current_type schematic

# Set keyboard layout to US (overrides default German layout from container)
catch {exec setxkbmap us}
